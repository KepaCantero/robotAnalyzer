# ── Analizador de Fondos y ETFs — variables de entorno ─────────────────────
# Copia a .env y rellena. Sin .env el sistema funciona en MODO DETERMINISTA
# (proveedor eco, universo semilla local, sin llamadas de red).

# LLM (opcional): cualquier endpoint compatible con OpenAI Chat Completions.
# Sin clave → ProveedorEco (offline, reproducible, para tests y demos).
ANALIZADOR_LLM_BASE_URL=https://api.openai.com/v1
ANALIZADOR_LLM_API_KEY=
ANALIZADOR_LLM_MODEL=gpt-4o-mini

# Caché de datos de mercado (TTL en horas; 0 = desactivar caché)
ANALIZADOR_CACHE_TTL_HOURS=12

# Yahoo Finance (sin clave). Pon "0" para operar sin red.
ANALIZADOR_ALLOW_NETWORK=1

# ── Web → API (cualquier web como fuente de datos) ─────────────────────────
# Opción A — Firecrawl (github.com/mendableai/firecrawl, AGPL):
#   self-host gratis:  docker run -d -p 3002:3002 firecrawl/firecrawl
#   y luego:           FIRECRAWL_BASE_URL=http://localhost:3002
#   cloud freemium:    FIRECRAWL_API_KEY=fc-... (500 créditos iniciales)
# Opción B — sin configurar nada, el sistema usa Jina Reader
#   (https://r.jina.ai) automáticamente: gratuito, sin clave, con rate limit.
FIRECRAWL_BASE_URL=
FIRECRAWL_API_KEY=

# Cotizaciones robustas (opcional, recomendado): yfinance maneja las sesiones
# y crumbs de Yahoo que el endpoint crudo no. pip install yfinance
# ANALIZADOR_USE_YFINANCE=1 (se detecta automáticamente si está importable)

# Almacenamiento de análisis
ANALIZADOR_DATA_DIR=./datos
